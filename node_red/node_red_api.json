    {
        "id": "787401975423d619",
        "type": "function",
        "z": "b34a2cf3ddab50e7",
        "name": "check and transform payload",
        "func": "const dp = msg.payload;\n\n//build look-up based on json array structure\nconst readings = Object.fromEntries(\n    (dp.sensordatavalues || []).map(s => [s.value_type, s.value])\n);\n\n// dynamic value extraction without positional index \nconst temperature = parseFloat(readings.BME280_temperature);\nconst pressure    = parseFloat(readings.BME280_pressure) / 100.0;\nconst humidity    = parseFloat(readings.BME280_humidity);\n\nfunction reject(reason) {\n    node.error(reason, msg);\n    msg.statusCode = 400;\n    msg.payload = { error: reason };\n    return [null, msg];\n}\n\n// data quality checks\nif (!Number.isFinite(temperature) || temperature < -50 || temperature > 85) {\n    return reject(`Temperature out of range: ${temperature} (expected -50..85 \\u00b0C)`);\n}\nif (!Number.isFinite(humidity) || humidity > 100) {\n    return reject(`Humidity out of range: ${humidity} (expected <= 100 %)`);\n}\nif (!Number.isFinite(pressure) || pressure < 0 || pressure > 1100) {\n    return reject(`Pressure out of range: ${pressure} (expected 0..1100 hPa)`);\n}\n\n// parse timestamp: strip DT# prefix, fix separator, add Z\nconst now = new Date()\nconst ts = now.toISOString()\n\n// modify payload\nmsg.payload = {\n    Temperature: temperature,\n    Pressure: pressure,\n    Humidity: humidity,\n    RawData: dp,\n    timestamp_utc: ts\n};\n\n// define query params \nmsg.queryParams = [\n    { name: \"Temperature\", type: \"FLOAT\", value: msg.payload.Temperature },\n    { name: \"Pressure\", type: \"FLOAT\", value: msg.payload.Pressure },\n    { name: \"Humidity\", type: \"FLOAT\", value: msg.payload.Humidity },\n    { name: \"RawData\", type: \"NVARCHAR\", value: JSON.stringify(dp) }\n];\n\n\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
